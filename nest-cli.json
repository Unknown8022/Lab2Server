{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/untitled/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/untitled/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/untitled",
  "projects": {
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "monitoring-service": {
      "type": "application",
      "root": "apps/monitoring-service",
      "entryFile": "main",
      "sourceRoot": "apps/monitoring-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/monitoring-service/tsconfig.app.json"
      }
    },
    "storage-service": {
      "type": "application",
      "root": "apps/storage-service",
      "entryFile": "main",
      "sourceRoot": "apps/storage-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/storage-service/tsconfig.app.json"
      }
    },
    "untitled": {
      "type": "application",
      "root": "apps/untitled",
      "entryFile": "main",
      "sourceRoot": "apps/untitled/src",
      "compilerOptions": {
        "tsConfigPath": "apps/untitled/tsconfig.app.json"
      }
    }
  }
}